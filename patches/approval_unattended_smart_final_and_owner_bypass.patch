+def _get_smart_final_on_unattended() -> bool:
+    """``approvals.smart_final_on_unattended`` (default False): when True, on an
+    unattended platform (api_server/webhook/msgraph_webhook) the smart-approval
+    reviewer's verdict is FINAL — a non-APPROVE verdict (DENY or ESCALATE) resolves
+    immediately (fail-closed) instead of parking on a human prompt nobody can answer
