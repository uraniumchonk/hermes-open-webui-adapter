+# --- One-time owner bypass for the user's deny rules (the backstop floor) ---
+# The owner explicitly authorizes a floor-blocked command by writing its EXACT text (one
+# per line) to a profile-local file. The floor check consumes a matching line (one-time),
+# so a bypass can never be replayed. It is freshness-capped (a stale file is ignored) and
+# every consumption is appended to an audit log. This is deliberately the ONLY override for
+# approvals.deny — yolo / mode=off / containers still cannot bypass it, and the hardline
+# floor (rm -rf /, etc.) is checked separately and is never bypassable.
+_OWNER_BYPASS_FRESH_SECS = 300
+
+
+def _owner_bypass_path():
+    """Profile-local one-time owner-bypass file (``<hermes_home>/cache/owner_bypass.txt``)."""
+    from pathlib import Path
+    from hermes_constants import get_hermes_home
+    return Path(get_hermes_home()) / "cache" / "owner_bypass.txt"
+
+
+def _consume_owner_bypass(command: str) -> bool:
+    """If the exact command is in the (fresh) owner-bypass file, consume that one line and
+    return True. One-time (the line is removed), exact-command (no globs), freshness-capped
+    (file mtime within ``_OWNER_BYPASS_FRESH_SECS``), and logged to ``owner_bypass_audit.log``."""
+    import time
+    path = _owner_bypass_path()
+    try:
+        if not path.exists():
+            return False
+        if time.time() - path.stat().st_mtime > _OWNER_BYPASS_FRESH_SECS:
+            return False  # stale bypass file: ignore
+        target = command.strip()
+        lines = path.read_text(encoding="utf-8").splitlines()
+        remaining, consumed = [], False
+        for line in lines:
+            if not consumed and line.strip() == target:
+                consumed = True  # consume this occurrence (one-time)
+                continue
+            remaining.append(line)
+        if not consumed:
+            return False
+        path.write_text(("\n".join(remaining) + "\n") if remaining else "", encoding="utf-8")
+        try:
+            audit = path.parent / "owner_bypass_audit.log"
+            with open(audit, "a", encoding="utf-8") as f:
+                f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} BYPASS {target[:300]}\n")
+        except Exception:
+            logger.debug("owner bypass audit log failed", exc_info=True)
+        return True
+    except Exception:
+        logger.debug("owner bypass check failed", exc_info=True)
+        return False
+
+
