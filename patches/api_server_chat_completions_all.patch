+# vision_analyze native fast path returns a multimodal envelope with full
+# base64 pixels. That result still goes into the agent loop for the model, but
+# hermes.tool.progress is only for UI/tool-filter cards — dumping multi-MB
+# base64 there OOMs proxies (readline high_water) and drops Open WebUI.
+_DATA_URL_RE = re.compile(
+    r"data:image/[a-zA-Z0-9.+-]+;base64,[A-Za-z0-9+/=\s]{64,}",
+    re.MULTILINE,
+)
+_PROGRESS_RESULT_SOFT_CAP = 32_768
+
+
+def _redact_progress_arguments(function_args: Any) -> Any:
+    """Strip base64 / oversized strings from tool-progress arguments."""
+    args = function_args or {}
+    if isinstance(args, str):
+        try:
+            args = json.loads(args)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            if "data:image" in args or len(args) > 4000:
+                return {"_redacted": True, "note": f"arguments redacted ({len(args)} chars)"}
+            return args
+    if not isinstance(args, dict):
+        return args
+    clean: Dict[str, Any] = {}
+    for key, value in args.items():
+        if isinstance(value, str) and (
+            value.startswith("data:image")
+            or ("base64" in value[:80] and len(value) > 2000)
+            or len(value) > 8000
+        ):
+            clean[key] = f"[redacted {len(value)} chars]"
+        elif isinstance(value, list) and key in {
+            "image_url", "image_urls", "images", "image_paths", "paths",
+        }:
+            clean[key] = f"[redacted list len={len(value)}]"
+        else:
+            clean[key] = value
+    return clean
+
+
+def _redact_progress_result(function_result: Any) -> str:
+    """Serialize tool result for hermes.tool.progress without base64 pixels.
+
+    Full multimodal envelopes stay inside the agent loop; this string is only
+    for SSE consumers (hermes_tool_filter / Open WebUI tool cards).
+    """
+    if function_result is None:
+        return ""
+
+    obj: Any = function_result
+    if isinstance(function_result, str):
+        stripped = function_result.lstrip()
+        looks_multi = (
+            stripped.startswith("{")
+            and (
+                '"_multimodal"' in function_result[:120]
+                or "_multimodal" in function_result[:80]
+                or "data:image" in function_result[:2000]
+            )
+        )
+        if looks_multi:
+            try:
+                obj = json.loads(function_result)
+            except (TypeError, ValueError, json.JSONDecodeError):
+                redacted = _DATA_URL_RE.sub("[base64_image_redacted]", function_result)
+                if len(redacted) > _PROGRESS_RESULT_SOFT_CAP:
+                    return (
+                        redacted[:_PROGRESS_RESULT_SOFT_CAP]
+                        + f"...[truncated from {len(function_result)} chars]"
+                    )
+                return redacted
+        else:
+            if "data:image" in function_result or len(function_result) > 100_000:
+                redacted = _DATA_URL_RE.sub("[base64_image_redacted]", function_result)
+                if len(redacted) > _PROGRESS_RESULT_SOFT_CAP:
+                    return (
+                        redacted[:_PROGRESS_RESULT_SOFT_CAP]
+                        + f"...[truncated from {len(function_result)} chars]"
+                    )
+                return redacted
+            return function_result
+
+    if isinstance(obj, dict) and obj.get("_multimodal"):
+        raw_meta = obj.get("meta")
+        meta: Dict[str, Any] = raw_meta if isinstance(raw_meta, dict) else {}
+        slim_meta: Dict[str, Any] = {}
+        for k in ("image_url", "size_bytes", "native_vision"):
+            if k in meta:
+                slim_meta[k] = meta[k]
+        slim: Dict[str, Any] = {
+            "_multimodal_redacted": True,
+            "text_summary": obj.get("text_summary")
+            or "Image loaded natively (base64 redacted from progress SSE)",
+            "meta": slim_meta,
+        }
+        texts: List[str] = []
+        for part in obj.get("content") or []:
+            if isinstance(part, dict) and part.get("type") == "text" and part.get("text"):
+                texts.append(str(part["text"]))
+        if texts:
+            slim["text"] = "\n".join(texts)
+        return json.dumps(slim, ensure_ascii=False)
+
+    try:
+        result_str = obj if isinstance(obj, str) else json.dumps(obj, ensure_ascii=False)
+    except (TypeError, ValueError):
+        result_str = str(obj)
+    if "data:image" in result_str:
+        result_str = _DATA_URL_RE.sub("[base64_image_redacted]", result_str)
+    if len(result_str) > 100_000:
+        return result_str[:_PROGRESS_RESULT_SOFT_CAP] + f"...[truncated from {len(result_str)} chars]"
+    return result_str
+
