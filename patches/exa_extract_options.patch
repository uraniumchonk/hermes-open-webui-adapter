+def _exa_extract_options() -> tuple:
+    """Read Exa extract tuning knobs from config (web.*).
+
+    Returns ``(max_characters, max_age_hours, filter_empty_results)``:
+
+    - ``max_characters``: aligns with Hermes's ``web.extract_char_limit``
+      (default 15000) so Exa returns as much as Hermes will keep, instead
+      of the SDK's 10000-char default truncating long pages early.
+    - ``max_age_hours``: cache freshness via ``web.exa_max_age_hours``
+      (default 0 = always fetch fresh). 0 = always fresh, -1 = cache only,
+      N = hours.
+    - ``filter_empty_results``: drop empty results via
+      ``web.exa_filter_empty_results`` (default True).
+    """
+    try:
+        from hermes_cli.config import load_config
+
+        web_cfg = load_config().get("web") or {}
+    except Exception:
+        web_cfg = {}
+
+    try:
+        max_characters = int(web_cfg.get("extract_char_limit", 15000))
+    except (TypeError, ValueError):
+        max_characters = 15000
+    if max_characters < 1000:
+        max_characters = 15000
+
+    try:
+        max_age_hours = int(web_cfg.get("exa_max_age_hours", 0))
+    except (TypeError, ValueError):
+        max_age_hours = 0
+
+    filter_empty = bool(web_cfg.get("exa_filter_empty_results", True))
+    return max_characters, max_age_hours, filter_empty
+
+
