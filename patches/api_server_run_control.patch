+async def _handle_list_runs(self, request: web.Request, *, _api_server) -> web.Response:
+    """GET /v1/runs — list this caller's runs, newest first.
+
+    Without a list, a client that lost its stream (or never captured the id) cannot address the
+    turn it just started: ``POST /v1/runs/{id}/stop`` needs an id it has no way to learn. Every
+    surface that spawns a stream agent registers its run, so listing is the control-plane entry.
+    ``?active=1`` keeps only runs still executing. Terminal records are included until the
+    status TTL sweep drops them, so a late poll still resolves.
+    """
+    auth_err = self._check_run_auth(request, permission="status")
+    if auth_err:
+        return auth_err
+    active_only = str(request.query.get("active", "")).lower() in {"1", "true", "yes"}
+    data = []
+    for run_id, status in list(self._run_statuses.items()):
+        if not self._request_owns_run(request, run_id):
+            continue
+        task = self._active_run_tasks.get(run_id)
+        active = run_id in self._active_run_agents or (task is not None and not task.done())
+        if active_only and not active:
+            continue
+        data.append({**status, "active": active})
+    data.sort(key=lambda row: float(row.get("created_at") or 0), reverse=True)
+    return web.json_response({"object": "list", "data": data})
+
