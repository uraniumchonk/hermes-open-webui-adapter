-def reapply_reasoning_echo(api_messages: list, needs_thinking_pad: bool) -> int:
-    """Re-pad (or strip) assistant turns' reasoning_content for the ACTIVE provider.
+def reapply_reasoning_echo(
+    api_messages: list,
+    needs_thinking_pad: bool,
+    preserve_thinking: bool = False,
+) -> int:
+    """Re-pad (or strip) assistant turns' reasoning fields for the ACTIVE provider.
 
     ``api_messages`` is built once under the primary provider; a mid-conversation fallback
     can switch providers, so baked-in fields must be reconciled: TO a require-side provider
     re-applies the pad (else 400), TO a strict one strips it (else 422). Idempotent.
     Returns the number of assistant turns changed.
+
+    Local patch (issue #56004): the ``reasoning`` field is reconciled too.
+    vLLM >= 0.20 re-renders historical thinking from ``reasoning`` (and
+    silently drops ``reasoning_content`` on input) when the served chat
+    template supports ``preserve_thinking`` (Qwen3.6/3.8, Gemma 4).  For
+    preserve_thinking routes the non-empty ``reasoning`` field is kept; for
+    every other provider it is stripped so strict endpoints never see it.
     """
     changed = 0
     for api_msg in api_messages:
@@ -637,6 +648,17 @@ def reapply_reasoning_echo(api_messages: list, needs_thinking_pad: bool) -> int:
         elif "reasoning_content" in api_msg:
             api_msg.pop("reasoning_content", None)
             changed += 1
+        # Local patch (issue #56004): reconcile the `reasoning` field.
+        # Keep non-empty values only for preserve_thinking routes; strip
+        # them everywhere else (strict providers reject unknown fields, and
+        # empty values would render empty historical blocks that break
+        # prefix caching — QwenLM/Qwen3.8#131).
+        if "reasoning" in api_msg:
+            rt = api_msg.get("reasoning")
+            keep = preserve_thinking and isinstance(rt, str) and rt.strip()
+            if not keep:
+                api_msg.pop("reasoning", None)
+                changed += 1
     return changed
 
 
diff --git a/agent/reasoning_params.py b/agent/reasoning_params.py
index 05b253a654..8f57d966da 100644
--- a/agent/reasoning_params.py
+++ b/agent/reasoning_params.py
@@ -153,6 +153,35 @@ class ReasoningParamsMixin:
         except Exception:
             return False
 
+    def _read_preserve_thinking_from_config(self) -> bool:
+        """Resolve the ``preserve_thinking`` capability for the current route.
+
+        Local patch (issue #56004): vLLM >= 0.20 re-renders historical
+        thinking from the ``reasoning`` field (NOT ``reasoning_content``,
+        which it silently drops on input) when the served chat template
+        supports ``preserve_thinking`` (Qwen3.6/3.8, Gemma 4).  The flag is
+        declared per custom-provider model entry, e.g.::
+
+            custom_providers:
+              - base_url: http://127.0.0.1:18080/v1
+                models:
+                  qwen-27b-default:
+                    preserve_thinking: true
+
+        True only when the *current* (model, base_url) route explicitly
+        opts in; anything else (missing entry, non-bool, non-custom
+        provider) returns False.
+        """
+        try:
+            from hermes_cli.config import get_custom_provider_model_capability
+            return bool(
+                get_custom_provider_model_capability(
+                    self.model, self.base_url, "preserve_thinking"
+                )
+            )
+        except Exception:
+            return False
+
     # Echo families are host/provider-driven, not model-name-driven: aggregators re-exporting Kimi reject the
     # echo. Rule table: ``message_sanitization._REASONING_ECHO_RULES``. Kimi deliberately passes the raw
     # provider and no model (its rule matches exact provider ids + hosts only).
