+# Session marker for the /v1/responses path: hermes_tool_filter embeds the
+# gateway's session id as an HTML comment in the assistant's final text so
+# stateless clients (Open WebUI) can continue the session on the next turn.
+# The marker must NEVER reach the model: if the LLM sees the pattern it
+# hallucinates fresh instances into its output (observed live: a Qwen turn
+# copied the marker shape with a new UUID, which then persisted to SessionDB
+# and contaminated the session). Strip it from all inbound content.
+_HERMES_SID_MARKER_RE = re.compile(r"<!--hermes-sid:[A-Za-z0-9][A-Za-z0-9_-]{7,63}-->")
+# Fenced form: the marker is embedded in a code block (visible session tag).
+# Strip the whole fence+marker+fence so no empty code block reaches the model.
+_HERMES_SID_MARKER_FENCED_RE = re.compile(
+    r"\n*```[ \t]*\n?<!--hermes-sid:[A-Za-z0-9][A-Za-z0-9_-]{7,63}-->\n?[ \t]*```\n*"
+)
+
+
+def _strip_hermes_sid_markers(content: Any) -> Any:
+    """Remove <!--hermes-sid:...--> markers from message content (str or parts list)."""
+    if isinstance(content, str):
+        content = _HERMES_SID_MARKER_FENCED_RE.sub("", content)
+        return _HERMES_SID_MARKER_RE.sub("", content)
+    if isinstance(content, list):
+        return [
+            {**p, "text": _strip_hermes_sid_markers(p["text"])}
+            if isinstance(p, dict) and isinstance(p.get("text"), str)
+            else p
+            for p in content
+        ]
+    return content
+
