diff --git a/agent/high_res_flags.py b/agent/high_res_flags.py
new file mode 100644
index 0000000000..420739403b
--- /dev/null
+++ b/agent/high_res_flags.py
@@ -0,0 +1,46 @@
+"""Session-scoped high-res vision flags (local patch).
+
+``vision_analyze(high_res=True)`` marks the calling session so that the main
+loop's API requests for the rest of that turn carry ``X-Meow-No-Compress: 1``.
+The metrics proxy (18080) skips its image downscaling for those requests, so
+the image reaches the backend at full resolution (up to the backend's own
+~16.8 MP cap) instead of the proxy's compressed budget.
+
+Lifecycle: set during a tool round, cleared at the start of the NEXT turn
+(``run_conversation``), so the flag covers every API call of the turn in which
+the image was loaded — stable request bytes within the turn, no prompt-cache
+churn — and reverts to normal compression on later turns.
+
+Keyed by session id (one process serves many sessions); thread-safe.
+"""
+
+from __future__ import annotations
+
+import threading
+
+_lock = threading.Lock()
+_active: dict[str, bool] = {}
+
+
+def mark_high_res(session_id: str | None) -> None:
+    """Mark ``session_id`` for full-resolution image requests (no-op if empty)."""
+    if not session_id:
+        return
+    with _lock:
+        _active[session_id] = True
+
+
+def is_high_res_active(session_id: str | None) -> bool:
+    """True while the session's high-res flag is set (no-op if empty)."""
+    if not session_id:
+        return False
+    with _lock:
+        return _active.get(session_id, False)
+
+
+def clear_high_res(session_id: str | None) -> None:
+    """Drop the session's high-res flag (no-op if empty or unset)."""
+    if not session_id:
+        return
+    with _lock:
+        _active.pop(session_id, None)
